<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>Rivo</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.8</string>
    <key>CFBundleVersion</key><string>10</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>UIBackgroundModes</key><array><string>location</string></array>
    <key>NSLocationWhenInUseUsageDescription</key><string>Rivo records your driving mileage after you enable auto-track. You choose Business or Personal and which trips to submit.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key><string>Rivo records detected drives while your screen is locked or you use another app. This includes personal trips, which stay private unless you submit them as business. Active deliveries share live location. Pause anytime.</string>
    <key>NSCameraUsageDescription</key><string>Take a delivery proof photo only when you choose to add one.</string>
    <key>NSPhotoLibraryUsageDescription</key><string>Choose a delivery proof photo when submitting delivery completion.</string>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
</dict></plist>
