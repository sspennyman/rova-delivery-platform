# Wix order sync
# Create a Wix API key with Read Orders permission and use your site ID from the Wix dashboard URL.
WIX_API_KEY=
WIX_SITE_ID=

# Optional filters for delivery-ready orders.
WIX_ORDER_STATUSES=APPROVED
WIX_PAYMENT_STATUSES=PAID
WIX_FULFILLMENT_STATUSES=NOT_FULFILLED,PARTIALLY_FULFILLED,FULFILLED
WIX_SYNC_LOOKBACK_DAYS=1
WIX_SYNC_LIMIT=100
WIX_SYNC_INTERVAL_MS=300000
WIX_PICKUP_LABEL=1675 Cyrville Rd

# Optional fallback rate for imported orders before a driver is assigned.
WIX_DEFAULT_KM_RATE=0

# Encrypts storefront API credentials saved through the Rova Channels screen.
# Use a long random value in production. OWNER_SETUP_CODE is used as a fallback.
INTEGRATION_ENCRYPTION_KEY=

# Google Maps embedded route map, live ETA, and stop optimization.
# Use a browser-restricted Google Maps Platform key with Maps JavaScript API and Routes API enabled.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Team login
COMPANY_NAME=Rova
OWNER_SETUP_CODE=change-this-setup-code

# Driver invitation email (Resend)
RESEND_API_KEY=
INVITE_FROM_EMAIL=Rova <drivers@your-verified-domain.com>
